local function a()
getgenv().DebugPrint = false

local Thread = {}
local Assert = {}
Thread.__index = Thread

function Thread.new()
  return setmetatable({
    libraries = {},
    stats = {
      passed = 0,
      failed = 0,
      skipped = 0,
      total = 0,
      time = 0
    }
  }, Thread)
end

function Assert.istrue(cond, msg)
  if not cond then
    return error(msg or "expected true", 3)
  end
end

function Assert.isfalse(cond, msg)
  if cond then
    return error(msg or "expected false", 3)
  end
end

function Assert.equals(a, b, msg)
  if a ~= b then
    return error(msg or ("expected " .. tostring(a) .. " == " .. tostring(b)), 3)
  end
end

function Assert.prerequisites(tbl)
  -- uh
  return true;
end

function Thread:library(name, fn)
  local library = {
    name = name,
    tests = {}
  }

  local function test(testName, testFn)
    table.insert(library.tests, {
      name = testName,
      fn = testFn
    })
  end

  fn(test, Assert)
  table.insert(self.libraries, library)
end

function Thread:run()
  local startAll = os.clock()

  for _, library in ipairs(self.libraries) do
    for _, test in ipairs(library.tests) do
      self.stats.total += 1
      local t0 = os.clock()

      local finished = false
      local ok, err
      print("Running test:", test.name)
      task.spawn(function()
        ok, err = pcall(test.fn)
        finished = true
      end)

      while not finished do
        task.wait()
      end

      local elapsed = os.clock() - t0
      self.stats.time += elapsed

      if ok then
        self.stats.passed += 1
        test.result = "PASS"
        print("Past", test.name)
      else
        self.stats.failed += 1
        test.result = "FAIL"
        test.error = tostring(err)
        print("❌ ", test.name, "failed with error:", tostring(err))
      end

      test.time = elapsed
      test.library = library.name
    end
  end

  self:report(os.clock() - startAll)
end

function Thread:report(totalTime)
  warn("test yay")
  warn("Total Tests : " .. tostring(self.stats.total))
  warn("Passed      : " .. tostring(self.stats.passed))
  warn("Failed      : " .. tostring(self.stats.failed))
  warn("Time        : " .. string.format("%.4fs", totalTime))

  for _, library in ipairs(self.libraries) do
    print("\n[" .. tostring(library.name) .. "]")
    for _, test in ipairs(library.tests) do
      if test.result == "PASS" then
        print("  ✅ " .. tostring(test.name) .. " (" .. string.format("%.4fs", test.time) .. ")")
      else
        warn("  ❌ " .. tostring(test.name))
        warn("    ↳ " .. tostring(test.error))
      end
    end
  end

  warn("════════════════════════════════════════════")
end

